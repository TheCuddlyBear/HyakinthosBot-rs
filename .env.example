# Discord Bot Token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Lavalink Server Configuration
LAVALINK_HOST=localhost:2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SSL=false

# Optional prefix for text commands (slash commands are also registered automatically)
BOT_PREFIX=!

REPLY_CHANCE=3

# Hugging Face Model Repository (and optional token if the repository is private)
HF_MODEL_REPO=TheCuddlyBear/HellGPT
# HF_TOKEN=hf_your_token_here
